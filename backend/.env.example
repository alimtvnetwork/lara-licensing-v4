# Lara Licensing v1 backend env template.
# Plan 06 step 2. Copy to .env for local dev; publish-laravel.ps1 (step 93) excludes .env from the publish/ folder.

APP_NAME="Lara Licensing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Root DB: holds Resellers, Prefixes, identity, UserRoles, AuthSessions.
DB_ROOT_CONNECTION=pgsql
DB_ROOT_HOST=127.0.0.1
DB_ROOT_PORT=5432
DB_ROOT_DATABASE=lara_root
DB_ROOT_USERNAME=lara
DB_ROOT_PASSWORD=

# Shard template: per-Reseller shard DSN is materialized by ShardResolver (Plan 06 step 10).
# {reseller} is substituted at runtime; provisioning done by `php artisan lara:shard:provision` (step 22).
DB_SHARD_TEMPLATE_CONNECTION=pgsql
DB_SHARD_TEMPLATE_HOST=127.0.0.1
DB_SHARD_TEMPLATE_PORT=5432
DB_SHARD_TEMPLATE_DATABASE=lara_shard_{reseller}
DB_SHARD_TEMPLATE_USERNAME=lara
DB_SHARD_TEMPLATE_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# Idempotency-Key TTL (seconds). Contract: 24h per spec/21-app/11-api-contracts/03-idempotency.md.
LARA_IDEMPOTENCY_TTL=86400

# Self-update manifest (Plan 06 steps 44-46, spec/21-app/17-self-update-endpoint.md v1.3.0).
# v1.0 pins channel to Stable; do NOT introduce SELF_UPDATE_CHANNEL here.
SELF_UPDATE_MANIFEST_URL=https://updates.example.invalid/lara/stable/manifest.json
SELF_UPDATE_PUBLIC_KEY=
SELF_UPDATE_SIGNING_KEY_PATH=

# Impersonation TTL (minutes). Spec 46 v1.1.0 default.
LARA_IMPERSONATION_TTL_MINUTES=30
