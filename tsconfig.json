{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "eslint.config.js"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting: keep this file at the compile-time settings the build has
       always shipped with. Additional strictness (noUncheckedIndexedAccess,
       noPropertyAccessFromIndexSignature, noUnusedLocals, etc.) has no
       baseline mechanism in TS, so any new flag becomes a big-bang cleanup.
       We enforce those categories via ESLint's type-aware rules against a
       bulk-suppressions baseline instead (see docs/static-analysis-frontend.md). */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
