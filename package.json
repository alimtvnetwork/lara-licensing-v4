{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vitest run && vite build",
    "build:dev": "vitest run && vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:strict": "eslint src --max-warnings=0",
    "lint:strict:suppress": "eslint src --suppress-all",
    "lint:ui": "python3 linter-scripts/check-hardcoded-colors.py && python3 linter-scripts/check-magic-literals.py",
    "lint:api-surface": "python3 linter-scripts/check-untyped-fetch.py && python3 linter-scripts/check-any-in-api.py && python3 linter-scripts/check-magic-endpoint-strings.py && python3 linter-scripts/check-preview-in-prod-bundle.py && python3 linter-scripts/check-screenshot-matrix-coverage.py && python3 linter-scripts/check-openapi-drift.py && python3 linter-scripts/check-schema-symbol-drift.py && python3 linter-scripts/check-dead-operations.py",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --project=chromium tests/e2e/specs/health.spec.ts tests/e2e/specs/auth-login.spec.ts tests/e2e/specs/admin-dashboard.spec.ts tests/e2e/specs/admin-license-crud.spec.ts tests/e2e/specs/portal-serial-lookup.spec.ts",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "check:error-codes": "node scripts/check-error-code-parity.mjs",
    "check:guidelines": "python3 linter-scripts/check-guideline-baseline.py",
    "coverage:matrix": "python3 linter-scripts/build-coverage-matrix.py",
    "verify": "bun run lint:ui && bun run lint:api-surface && bun run check:error-codes && bun run check:guidelines && bun run lint:strict && bun run typecheck && bun run test",
    "format": "prettier --write ."
  },
